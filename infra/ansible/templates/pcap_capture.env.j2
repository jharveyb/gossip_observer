{#
  EnvironmentFile for gossip-pcap@%i and gossip-pcap-sockmap@%i.

  systemd takes the rest of the line as the value, so PCAP_FILTER may contain
  spaces unquoted. In the unit, ${PCAP_FILTER} stays one argv element while
  $PCAP_ARGS is word-split -- see gossip-pcap@.service.j2.

  Rendered with: pcap_env_out, pcap_env_filter (set by the calling task).
#}
PCAP_LABEL={{ pcap_label }}
PCAP_DIR={{ pcap_dir }}
PCAP_IFACE={{ pcap_iface }}
PCAP_FILTER={{ pcap_env_filter }}
PCAP_ARGS={{ pcap_args }}
PCAP_OUT={{ pcap_env_out }}
PUB_IP={{ public_ip }}
SOCKMAP_INTERVAL={{ sockmap_interval }}
COLLECTOR_UUIDS={{ host_collectors | map(attribute='uuid') | join(' ') }}
